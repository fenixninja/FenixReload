# ==============================================================================
# FenixRELOAD - Archivo de Configuración de Módulos y Trazabilidad (LOGS)
# ==============================================================================
# Formato: clave=valor booleano (true para habilitar, false para omitir)
# Las líneas vacías o iniciadas con '#' son ignoradas por el cargador.
#
# Nota: Los módulos activos se cargarán siempre en orden secuencial estricto
# para preservar las dependencias funcionales en el navegador.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SELECCIÓN DE MÓDULOS ACTIVOS (Inyección en el DOM)
# ------------------------------------------------------------------------------

# Módulo 01: Utilidades base, validación JSON, decodificación JWT y detección adaptativa
utils=true

# Módulo 02: Extracción de datos del DOM, normalización y serialización JSON (getBody, getParams)
dom_params=true

# Módulo 03: Motor de plantillas, hidratación reactiva y renderizado de colecciones (print, println)
templates=true

# Módulo 04: Internacionalización y carga dinámica de diccionarios JSON (i18n)
i18n=true

# Módulo 05: Cliente de transporte HTTP / REST asíncrono (GET, POST, PUT, PATCH, DELETE)
http=true

# Módulo 06: Comunicación full-duplex en tiempo real con Socket.IO y brokers MQTT
sockets=true

# Módulo 07: Autenticación, persistencia de sesión en el DOM y resincronización de credenciales
auth=true

# Módulo 08: Orquestación de capas (layers), control de acceso por roles y carga de HTML modular
layers_roles=true

# Módulo 09: Notificaciones de escritorio mediante la Web Notifications API
notifications=true

# ------------------------------------------------------------------------------
# 2. CONFIGURACIÓN DE REGISTRO Y DEPURACIÓN (LOGS DEVTOOLS & AI)
# ------------------------------------------------------------------------------
# Reglas de precedencia:
# - log_all: Habilita los logs de TODOS los módulos simultáneamente si es true.
# - Si log_all=false, cada módulo responderá a su interruptor individual (log_<modulo>).
#
# Formato de salida:
# - Chrome DevTools: Badges estilizados con código de colores por módulo y función.
# - IA / Consola pura: [FR:MODULO][nombreFuncion] Mensaje descriptivo y payload JSON.
# ------------------------------------------------------------------------------

# Habilitador Maestro de Logs (true para encender todos los logs globalmente)
log_all=true

# Logs específicos por módulo / subsistema:
log_loader=true
log_utils=true
log_dom_params=true
log_templates=true
log_i18n=true
log_http=true
log_sockets=true
log_auth=true
log_layers_roles=true
log_notifications=true
